# Generate independent random values; never reuse SIP or CallGate credentials.
CALL_API_TOKEN=replace-with-32-byte-random-secret
DEVICE_API_TOKEN=replace-with-another-32-byte-random-secret
ORG_BOOTSTRAP_TOKEN=replace-with-a-separate-32-byte-random-secret
# Shared-token legacy endpoints are disabled by default. Enable only for isolated migration tests.
ENABLE_LEGACY_CALL_API=false
ENABLE_LEGACY_DEVICE_API=false
DATABASE_PATH=./calls.sqlite3
# MongoDB is the durable backend for all tenant API routes on Vercel.
# Production must set MONGODB_URI and MONGODB_DATABASE explicitly.
MONGODB_URI=
MONGODB_DATABASE=
# Optional isolated Atlas Preview test fallback (never used in Vercel production).
MONGODB_TEST_URI=
MONGODB_TEST_DATABASE=
# Set true for multi-instance deployments. Vercel defaults this to true when unset.
REQUIRE_DISTRIBUTED_RATE_LIMIT=false
IP_RATE_LIMIT_PER_MINUTE=120
GENERAL_RATE_LIMIT_PER_MINUTE=60
# Deprecated safety setting. The application rejects this override even when true.
ALLOW_UNSAFE_SQLITE_ON_VERCEL=false
ALLOWED_PREFIXES=+9677,+96773,+96771,+96770
MAX_CALL_SECONDS=1800
QUEUE_TTL_SECONDS=120
CELLULAR_RING_TIMEOUT_SECONDS=45
SIP_RING_TIMEOUT_SECONDS=45
RATE_LIMIT_PER_MINUTE=5

# Adasms provider credentials. Set ADASMS_API_KEY as a Vercel Secret; never commit it.
ADASMS_API_URL=https://adasms-standalone.vercel.app/api/sms/send
ADASMS_API_KEY=
# SMS destinations default to Yemeni mobile numbers only.
SMS_ALLOWED_PREFIXES=+9677
# Android device-token SMS is disabled unless explicitly enabled and allowlisted.
SMS_DEVICE_SEND_ENABLED=false
SMS_DEVICE_ALLOWLIST=

# Evolution API bridge. The API URL must point to a separately hosted Evolution service.
# Vercel hosts this FastAPI adapter/webhook; do not run the persistent Evolution server here.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_BAILEYS_INSTANCE=
EVOLUTION_CLOUD_INSTANCE=
EVOLUTION_SEND_ENABLED=false
EVOLUTION_WEBHOOK_SECRET_BAILEYS=
EVOLUTION_WEBHOOK_SECRET_CLOUD=
# JSON object mapping Evolution instance names to organization IDs; server-side secret/config only.
EVOLUTION_INSTANCE_ORG_MAP={}
WHATSAPP_ALLOWED_PREFIXES=+9677
# One central Telegram bot. Configure webhook URL /v1/telegram/webhook in Telegram.
# Set the token and webhook secret as encrypted Vercel Secrets, never in Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user IDs; empty means nobody is authorized.
TELEGRAM_ALLOWED_USER_IDS=
# Keep external actions disabled until separate production approval and full integration tests.
TELEGRAM_ACTION_EXECUTION_ENABLED=false
# n8n Cloud production webhook URL and independent shared secret.
N8N_WHATSAPP_WEBHOOK_URL=
N8N_WHATSAPP_WEBHOOK_TOKEN=
