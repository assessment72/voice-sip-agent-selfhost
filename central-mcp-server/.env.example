# Copy to .env on the server; never commit real credentials.
PORT=8788
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DATABASE=voice_sip_central
MCP_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADMIN_TOKEN
# One unique token per physical Android gateway. The ID must match the ID entered in the app.
GATEWAY_CREDENTIALS_JSON={"gw01":"REPLACE_WITH_A_UNIQUE_RANDOM_DEVICE_TOKEN"}
# Optional routing policy: priority first; disabled gateways are never selected.
# Omitted gateways default to priority 0 and enabled=true.
GATEWAY_ROUTING_POLICY_JSON={"gw01":{"priority":10},"gw02":{"priority":5}}

# Vercel adapter: live gateway state is instance-local until a shared state backend is implemented.
# Do not use this in production multi-gateway routing without a shared state/command bus.

# Persistent storage is required for multi-instance Vercel deployments.
