# Keep this file private. Never commit real secrets.
VOICX_ADMIN_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_ADMIN_SECRET
VOICX_DEVICES='[{"id":"phone-01","name":"HONOR MTN-NX1","token":"REPLACE_WITH_RANDOM_32_BYTE_DEVICE_SECRET"}]'
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user IDs, comma-separated. Private chats only.
TELEGRAM_ADMIN_IDS=123456789
HOST=0.0.0.0
PORT=8787
VOICX_STORE=/data/voicx-store.json

# MongoDB CRM (server-side only; never place credentials in the Android app).
MONGODB_URI=
MONGODB_DATABASE=voice_sip_agent_control
VOICX_CRM_TENANT_ID=replace-with-organization-id
# Numeric Telegram IDs authorized for CRM requests made by a registered device.
VOICX_CRM_TELEGRAM_ADMIN_IDS=123456789

# Hosted Call API SMS bridge. The Adasms provider key is NOT stored here.
VOICX_HOSTED_API_URL=https://voice-sip-agent-hosted-api-assessment72s-projects.vercel.app
VOICX_SMS_ORGANIZATION_ID=
VOICX_SMS_ORGANIZATION_TOKEN=
# Only needed when calling a Vercel deployment protected by SSO/deployment protection.
VOICX_HOSTED_API_BYPASS_TOKEN=
# Separate private-chat Telegram allowlist for SMS sending/history.
VOICX_SMS_TELEGRAM_ADMIN_IDS=123456789

# Adasms direct SMS provider (server-side only; use a rotated key in Vercel Sensitive env vars).
ADASMS_API_KEY=
